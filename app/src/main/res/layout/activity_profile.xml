<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6F1"
    android:padding="24dp">

    <!-- Заголовок -->

    <!-- Аватар + редактировать -->

    <TextView
        android:id="@+id/tv_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/raleway_bold"
        android:text="Profile"
        android:textColor="#432C81"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.047"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/rounded_avatar_background"
            android:src="@drawable/illustration_login"
            android:scaleType="centerCrop"
            android:contentDescription="User profile image" />

        <ImageView
            android:id="@+id/edit_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/edit_icon_background"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="Edit avatar icon" />
    </FrameLayout>

    <!-- Имя и email -->
    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Имя пользователя"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/avatar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="user@email.com"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- ScrollView -->
    <ScrollView
        android:id="@+id/scroll_fields"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_user_email"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Пример поля -->
            <LinearLayout
                style="@style/ProfileField"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="Name" />

                <EditText
                    android:id="@+id/edit_name"
                    style="@style/ProfileFieldInput"
                    android:hint="Name" />

                <ImageView
                    android:id="@+id/arrow_name"
                    style="@style/ProfileFieldIcon"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <LinearLayout
                style="@style/ProfileField"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="Surname" />

                <EditText
                    android:id="@+id/edit_surname"
                    style="@style/ProfileFieldInput"
                    android:hint="Surname" />

                <ImageView
                    android:id="@+id/arrow_surname"
                    style="@style/ProfileFieldIcon"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <LinearLayout
                style="@style/ProfileField"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="Age" />

                <EditText
                    android:id="@+id/edit_age"
                    style="@style/ProfileFieldInput"
                    android:hint="Age"
                    android:inputType="number" />

                <ImageView
                    android:id="@+id/arrow_age"
                    style="@style/ProfileFieldIcon"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <LinearLayout
                style="@style/ProfileField"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="Gender" />

                <Spinner
                    android:id="@+id/spinner_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:entries="@array/sex_options"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:popupBackground="#FFFFFF"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:id="@+id/arrow_gender"
                    style="@style/ProfileFieldIcon"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <LinearLayout
                style="@style/ProfileField"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="Weight" />

                <EditText
                    android:id="@+id/edit_weight"
                    style="@style/ProfileFieldInput"
                    android:hint="Weight"
                    android:inputType="number" />

                <ImageView
                    android:id="@+id/arrow_weight"
                    style="@style/ProfileFieldIcon"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <LinearLayout
                style="@style/ProfileField"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/ProfileFieldLabel"
                    android:text="Height" />

                <EditText
                    android:id="@+id/edit_height"
                    style="@style/ProfileFieldInput"
                    android:hint="Height"
                    android:inputType="number" />

                <ImageView
                    android:id="@+id/arrow_height"
                    style="@style/ProfileFieldIcon"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <!-- Кнопки CANCEL и SAVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#A095C1">

                    <Button
                        android:id="@+id/cancelButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="CANCEL"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/raleway_bold" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <Button
                        android:id="@+id/saveButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="SAVE"
                        android:textAllCaps="false"
                        android:textColor="#432C81"
                        android:textSize="20sp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/raleway_bold" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
