<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFCF4"
    android:padding="16dp" >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Заголовок -->
            <TextView
                android:id="@+id/tv_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Lifedata Survey"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#432C81"
                android:fontFamily="@font/raleway_bold" />

            <!-- Подзаголовок -->
            <TextView
                android:id="@+id/tv_lifedata_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="This section helps us better understand\nyour lifestyle and habits for a more\naccurate health analysis."
                android:textAlignment="center"
                android:textColor="#432C81"
                android:textSize="18sp"
                android:fontFamily="@font/raleway_bold"
                android:lineSpacingExtra="2dp"
                android:letterSpacing="-0.02" />

            <!-- Вопрос 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_profile_field"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Do you smoke?"
                    android:textSize="18sp"
                    android:textColor="#432C81"
                    android:fontFamily="@font/raleway_bold" />

                <Switch
                    android:id="@+id/switch_smoking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#432C81"
                    android:trackTint="#A095C1"/>
            </LinearLayout>

            <!-- Вопрос 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_profile_field"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Do you consume alcohol?"
                    android:textSize="18sp"
                    android:textColor="#432C81"
                    android:fontFamily="@font/raleway_bold" />

                <Switch
                    android:id="@+id/switch_alcohol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#432C81"
                    android:trackTint="#A095C1"/>
            </LinearLayout>

            <!-- Вопрос 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_profile_field"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Do you engage in regular physical activity?"
                    android:textSize="18sp"
                    android:textColor="#432C81"
                    android:fontFamily="@font/raleway_bold" />

                <Switch
                    android:id="@+id/switch_exercise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#432C81"
                    android:trackTint="#A095C1"/>
            </LinearLayout>

            <!-- Spinner -->
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_fruit_intake"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_field" />

            <!-- Кнопка Сохранить -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2">

                <!-- CANCEL с фоном #EDECF4 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#EDECF4"
                    app:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/button_cancel_lifestyle"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="CANCEL"
                        android:textAllCaps="false"
                        android:textColor="#432C81"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/raleway_bold"
                        android:backgroundTint="#EDECF4"
                        android:background="@android:color/transparent"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"/>
                </androidx.cardview.widget.CardView>

                <!-- SAVE с фоном #432C81 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#432C81"
                    app:cardUseCompatPadding="true">

                    <Button
                        android:id="@+id/button_save_lifestyle"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="SAVE"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/raleway_bold"
                        android:backgroundTint="#432C81"
                        android:background="@android:color/transparent"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Навигация -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FCFCF4"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:itemIconSize="32dp"
            app:labelVisibilityMode="labeled"
            android:background="#FCFCF4"/>
    </LinearLayout>
</LinearLayout>
